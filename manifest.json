{
  "manifest_version": 3,
  "name": "AdScope for Meta Ad Library",
  "version": "1.0.0",
  "description": "Spy on competitor ads in the Meta Ad Library: see days running (real), plus estimated spend and estimated views on every ad.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "*://*.facebook.com/ads/library/*",
    "*://*.facebook.com/ads/library*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AdScope",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/ads/library/*", "*://*.facebook.com/ads/library*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
